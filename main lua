    local btnDeletePlayer = Button(c)
    btnDeletePlayer.setText("Delete")
    btnDeletePlayer.setLayoutParams(LinearLayout.LayoutParams(0, -2, 1))
    buttonRowLayout.addView(btnDeletePlayer)

    cont.addView(buttonRowLayout)

    selectAllBtn.onClick = function()
      triggerFeedback()
      isAllSelected = not isAllSelected
      for _, item in ipairs(playerItemsList) do
        item.cb.setChecked(isAllSelected)
      end
      if isAllSelected then
        selectAllBtn.setText("Deselect All")
      else
        selectAllBtn.setText("Select All")
      end
      updateSelectedCount()
    end

    btnDeletePlayer.onClick = function()
      triggerFeedback()
      local selectedIndices = {}
      local selectedPlayerNames = {}
      for _, item in ipairs(playerItemsList) do
        if item.cb.isChecked() then
          table.insert(selectedIndices, item.index)
          table.insert(selectedPlayerNames, "• " .. item.name)
        end
      end
      
      if #selectedIndices == 0 then
        showToast("Please select at least one player to delete!")
        return
      end
      
      local confirmDlg = LuaDialog(c)
      registerDialog(confirmDlg)
      confirmDlg.setTitle("Confirm Deletion")
      local confirmLay = LinearLayout(c)
      confirmLay.setOrientation(1)
      confirmLay.setPadding(30, 30, 30, 30)
      
      local confirmMsg = TextView(c)
      confirmMsg.setText("Are you sure you want to delete these " .. #selectedIndices .. " player(s)?\n\n" .. table.concat(selectedPlayerNames, "\n"))
      confirmMsg.setTextSize(15)
      confirmMsg.setPadding(0, 0, 0, 20)
      confirmLay.addView(confirmMsg)
      
      local btnRow = LinearLayout(c)
      btnRow.setOrientation(0)
      
      local yesBtn = Button(c)
      yesBtn.setText("Yes")
      yesBtn.setLayoutParams(LinearLayout.LayoutParams(0, -2, 1))
      yesBtn.onClick = function()
        triggerFeedback()
        table.sort(selectedIndices, function(a, b) return a > b end)
        for _, idx in ipairs(selectedIndices) do
          table.remove(tm.players, idx)
        end
        saveData()
        showToast("Player(s) Deleted Successfully!")
        confirmDlg.dismiss()
        detailDlg.dismiss()
        showTournamentDetailView(tourIndex, teamIndex)
      end
      
