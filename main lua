        triggerFeedback()
        local rDlg = LuaDialog(c)
        registerDialog(rDlg)
        rDlg.setTitle("Options for " .. item.name)
        
        local rLay = LinearLayout(c)
        rLay.setOrientation(1)
        rLay.setPadding(30, 30, 30, 30)
        
        local roles = {
          "Captain (C)", 
          "Vice-Captain (VC)", 
          "Reserve (R)", 
          "None / Normal Player", 
          "Rename Player",
          "Transfer to Another Team",
          "Move Up",
          "Move Down",
          "Remove Player"
        }
        
        for _, rName in ipairs(roles) do
          local bRole = Button(c)
          bRole.setText(rName)
          bRole.onClick = function()
            triggerFeedback()
            rDlg.dismiss()
            
            if rName == "Captain (C)" then
              for _, other in ipairs(playerItemsList) do
                if other.role == "C" then
                  other.role = nil
                  other.roleBtn.setText("Role")
                end
              end
              item.role = "C"
              item.roleBtn.setText("C")
              showToast(item.name .. " is now Captain (C)")
              refreshDetailPreview()
              
            elseif rName == "Vice-Captain (VC)" then
              for _, other in ipairs(playerItemsList) do
                if other.role == "VC" then
                  other.role = nil
                  other.roleBtn.setText("Role")
                end
              end
              item.role = "VC"
              item.roleBtn.setText("VC")
              showToast(item.name .. " is now Vice-Captain (VC)")
              refreshDetailPreview()
              
            elseif rName == "Reserve (R)" then
              item.role = "R"
              item.roleBtn.setText("R")
              showToast(item.name .. " marked as Reserve (R)")
              refreshDetailPreview()

            elseif rName == "Transfer to Another Team" then
              showTransferPlayerDialog(tourIndex, teamIndex, item.index, detailDlg)
              
            elseif rName == "Rename Player" then
              local renDlg = LuaDialog(c)
              registerDialog(renDlg)
              renDlg.setTitle("Rename Player")
              
              local renLay = LinearLayout(c)
              renLay.setOrientation(1)
              renLay.setPadding(30, 30, 30, 30)
              
              local eNewName = EditText(c)
              eNewName.setText(item.name)
              renLay.addView(eNewName)
              
              local bSaveRen = Button(c)
              bSaveRen.setText("Save Name")
              bSaveRen.setPadding(0, 15, 0, 0)
              bSaveRen.onClick = function()
                triggerFeedback()
                local newName = eNewName.getText().toString():match("^%s*(.-)%s*$")
                if newName == "" then
                  showToast("Player name cannot be empty!")
                  return
                end
                
                local isDuplicate = false
                for pIndex, otherPlayer in ipairs(tm.players) do
                  if pIndex ~= item.index and otherPlayer:lower() == newName:lower() then
                    isDuplicate = true
                    break
                  end
                end
                
                if isDuplicate then
                  showToast("Another player already has this name in this team!")
                  return
                end

                for oIdx, otherTm in ipairs(tour.teams) do
                  if oIdx ~= teamIndex and otherTm.players then
                    for _, oP in ipairs(otherTm.players) do
                      if oP:lower() == newName:lower() then
                        local lockDlg = LuaDialog(c)
                        lockDlg.setTitle("Player Restriction Alert")
                        lockDlg.setMessage("Rule Violation: '" .. newName .. "' is already registered with team '" .. otherTm.teamName .. "' in this tournament.\n\nA player cannot play in two teams concurrently!")
                        lockDlg.setButton("OK", function() lockDlg.dismiss() end)
                        lockDlg.show()
                        return
                      end
                    end
                  end
                end
                
                tm.players[item.index] = newName
                saveData()
                showToast("Player renamed successfully!")
                renDlg.dismiss()
                detailDlg.dismiss()
                showTournamentDetailView(tourIndex, teamIndex)
              end
              renLay.addView(bSaveRen)
              renDlg.setView(renLay)
              renDlg.show()

            elseif rName == "Move Up" then
              if item.index > 1 then
                tm.players[item.index], tm.players[item.index - 1] = tm.players[item.index - 1], tm.players[item.index]
                saveData()
                detailDlg.dismiss()
                showTournamentDetailView(tourIndex, teamIndex)
                showToast(item.name .. " moved up")
              else
                showToast("Player is already at the top!")
              end

            elseif rName == "Move Down" then
              if item.index < #tm.players then
                tm.players[item.index], tm.players[item.index + 1] = tm.players[item.index + 1], tm.players[item.index]
                saveData()
                detailDlg.dismiss()
                showTournamentDetailView(tourIndex, teamIndex)
                showToast(item.name .. " moved down")
              else
                showToast("Player is already at the bottom!")
              end

            elseif rName == "Remove Player" then
              local confirmDelDlg = LuaDialog(c)
              registerDialog(confirmDelDlg)
              confirmDelDlg.setTitle("Confirm Removal")
              
              local cLay = LinearLayout(c)
              cLay.setOrientation(1)
              cLay.setPadding(30, 30, 30, 30)
              
              local cMsg = TextView(c)
              cMsg.setText("Are you sure you want to remove '" .. item.name .. "' from this team?")
              cMsg.setTextSize(16)
              cMsg.setPadding(0, 0, 0, 20)
              cLay.addView(cMsg)
              
              local cRow = LinearLayout(c)
              cRow.setOrientation(0)
              
              local btnYes = Button(c)
              btnYes.setText("Yes")
              btnYes.setLayoutParams(LinearLayout.LayoutParams(0, -2, 1))
              btnYes.onClick = function()
                triggerFeedback()
                table.remove(tm.players, item.index)
                saveData()
                showToast(item.name .. " removed successfully!")
                confirmDelDlg.dismiss()
                detailDlg.dismiss()
                showTournamentDetailView(tourIndex, teamIndex)
              end
              
              local btnNo = Button(c)
              btnNo.setText("No")
              btnNo.setLayoutParams(LinearLayout.LayoutParams(0, -2, 1))
              btnNo.onClick = function()
                triggerFeedback()
                confirmDelDlg.dismiss()
              end
              
              cRow.addView(btnYes)
              cRow.addView(btnNo)
              cLay.addView(btnRow)
              confirmDelDlg.setView(cLay)
              confirmDelDlg.show()
              
            else
              item.role = nil
              item.roleBtn.setText("Role")
              showToast("Role cleared for " .. item.name)
              refreshDetailPreview()
            end
          end
          rLay.addView(bRole)
        end
        rDlg.setView(rLay)
        rDlg.show()
      end
    end
  end

  local backBtn = Button(c)
  backBtn.setText("Back to Teams List")
  backBtn.setPadding(0, 10, 0, 0)
  backBtn.onClick = function()
    triggerFeedback()
    detailDlg.dismiss()
    showTournamentTeamsView(tourIndex)
  end
  cont.addView(backBtn)
  
  detailDlg.setView(scroll)
  detailDlg.show()
end

function showCreateTeamDialog(tourIndex, parentDlg)
  local c = getContext()
  triggerFeedback()
  local tour = recordsList[tourIndex]
  if not tour then return end
  
  local dlg = LuaDialog(c)
  registerDialog(dlg)
  dlg.setTitle("Create Team & Squad")
  
  local scroll = ScrollView(c)
  local lay = LinearLayout(c)
  lay.setOrientation(1)
  lay.setPadding(30, 30, 30, 30)
  scroll.addView(lay)
  
  local tvTeam = TextView(c)
  tvTeam.setText("Team Name:")
  lay.addView(tvTeam)
  
  local eTeam = EditText(c)
  eTeam.setHint("Enter team name (e.g. Shaheen XI)")
  lay.addView(eTeam)
  
  local tvSquad = TextView(c)
  tvSquad.setText("Squad (One player per line):")
  tvSquad.setPadding(0, 15, 0, 0)
  lay.addView(tvSquad)
  
  local eSquad = EditText(c)
  eSquad.setHint("Paste or enter player names here...")
  eSquad.setMinLines(6)
  eSquad.setGravity(Gravity.TOP)
  lay.addView(eSquad)

  local bImportMaster = Button(c)
  bImportMaster.setText("Import from Master List")
  bImportMaster.onClick = function()
    showImportMasterListDialog(eSquad)
  end
  lay.addView(bImportMaster)
  
  local bSave = Button(c)
  bSave.setText("Save Team & Squad")
  bSave.setPadding(0, 15, 0, 0)
  bSave.onClick = function()
    triggerFeedback()
    local teamName = eTeam.getText().toString():match("^%s*(.-)%s*$")
    local squadRaw = eSquad.getText().toString()
    
    if teamName == "" then
      showToast("Please enter a team name!")
      return
    end
    
    tour.teams = tour.teams or {}
    for _, tm in ipairs(tour.teams) do
      if tm.teamName:lower() == teamName:lower() then
        showToast("A team with this name already exists in this tournament!")
        return
      end
    end
    
    local players = {}
    local blockedPlayers = {}
    for p in squadRaw:gmatch("[^\r\n]+") do
      local trimmed = p:match("^%s*(.-)%s*$")
      if trimmed ~= "" then
        local isBlocked = false
        local registeredTeam = nil
        for _, existingTeam in ipairs(tour.teams) do
          if existingTeam.players then
            for _, exP in ipairs(existingTeam.players) do
              if exP:lower() == trimmed:lower() then
                isBlocked = true
                registeredTeam = existingTeam.teamName
                break
              end
            end
          end
          if isBlocked then break end
        end

        if isBlocked then
          table.insert(blockedPlayers, "• " .. trimmed .. " is already playing for " .. registeredTeam)
        else
          table.insert(players, trimmed)
        end
      end
    end
    
    table.insert(tour.teams, {
      teamName = teamName,
      players = players
    })
    saveData()
    showToast("Team '" .. teamName .. "' added successfully!")
    dlg.dismiss()
    if parentDlg then parentDlg.dismiss() end
    showTournamentTeamsView(tourIndex)

    if #blockedPlayers > 0 then
      local warnDlg = LuaDialog(c)
      warnDlg.setTitle("Player Eligibility Alert")
      warnDlg.setMessage("Notice: The following player(s) were BLOCKED from joining '" .. teamName .. "' because tournament rules restrict a player to one team only:\n\n" .. table.concat(blockedPlayers, "\n\n") .. "\n\n(To include them, please transfer them via the player menu).")
      warnDlg.setButton("Acknowledge", function() warnDlg.dismiss() end)
      warnDlg.show()
    end
  end
  lay.addView(bSave)
  
  dlg.setView(scroll)
  dlg.show()
end

