  addPlayerBtn.onClick = function()
    triggerFeedback()
    local pDlg = LuaDialog(c)
    registerDialog(pDlg)
    pDlg.setTitle("Add New Player")
    local l2 = LinearLayout(c)
    l2.setOrientation(1)
