local function importFile(filePath)
  local c = getContext()
  pcall(function()
    local f = io.open(filePath, "r")
    if not f then
      showToast("Failed to open the backup file!")
      return
    end
    
    local content = f:read("*all")
    f:close()
    
    if not content or content == "" then
      showToast("Backup file is empty!")
      return
    end
    
    loadData()
    
    local parsedTournaments = {}
    for block in content:gmatch("(.-)%[---END---%]\n*") do
      if block ~= "" then
        local tour = block:match("Tournament: *(.-)\n")
        local cleanTour = tour and tour:match("^%s*(.-)%s*$")
        local statusMatch = block:match("Status: *(.-)\n")
        local cleanStatus = statusMatch and statusMatch:match("^%s*(.-)%s*$") or "Active"
        if cleanStatus ~= "Completed" then cleanStatus = "Active" end

        local teamName = block:match("Team: *(.-)\n") or block:match("Team: *(.*)")
        local cleanTeam = teamName and teamName:match("^%s*(.-)%s*$")
        local playersStr = block:match("Players:\n*(.*)") or block:match("Players: *(.*)")
        
        if cleanTour then
          local tEntry = nil
          for _, t in ipairs(parsedTournaments) do
            if t.tournament:lower() == cleanTour:lower() then
              tEntry = t
              break
            end
          end
          if not tEntry then
            tEntry = { tournament = cleanTour, status = cleanStatus, teams = {} }
            table.insert(parsedTournaments, tEntry)
          else
            tEntry.status = cleanStatus
          end
          
          if cleanTeam and cleanTeam ~= "" and cleanTeam:lower() ~= "none" then
            local players = {}
            if playersStr and playersStr ~= "" then
              for p in playersStr:gmatch("[^\r\n]+") do
                local trimmed = p:match("^%s*(.-)%s*$")
                if trimmed ~= "" and trimmed ~= "Players:" then
                  table.insert(players, trimmed)
                end
              end
            end
            table.insert(tEntry.teams, {
              teamName = cleanTeam,
              players = players
            })
          end
        end
      end
    end
    
    if #parsedTournaments == 0 then
      showToast("Error: Invalid backup file format!")
      return
    end
    
    local function processImport(index, overrideDuplicates)
      if index > #parsedTournaments then
        saveData()
        showToast("Import process completed successfully!")
        speakTTS("Import Completed Successfully")
        showTournamentOptions()
        return
      end
      
      local incoming = parsedTournaments[index]
      local existingIndex = nil
      for idx, existing in ipairs(recordsList) do
        if existing.tournament:lower() == incoming.tournament:lower() then
          existingIndex = idx
          break
        end
      end
      
      if existingIndex then
        if overrideDuplicates then
          recordsList[existingIndex] = incoming
          processImport(index + 1, overrideDuplicates)
        else
          local ovDlg = LuaDialog(c)
          ovDlg.setTitle("Tournament Already Exists")
          ovDlg.setMessage("Tournament '" .. incoming.tournament .. "' already exists in your extension.\n\nDo you want to override it with the imported data?")
          ovDlg.setButton("Override (Update)", function()
            ovDlg.dismiss()
            recordsList[existingIndex] = incoming
            processImport(index + 1, true)
          end)
          ovDlg.setButton2("Skip", function()
            ovDlg.dismiss()
            processImport(index + 1, false)
          end)
          ovDlg.show()
        end
      else
        table.insert(recordsList, incoming)
        processImport(index + 1, overrideDuplicates)
      end
    end
    
    processImport(1, false)
  end)
end

local function showCustomFileBrowser(startPath)
  local c = getContext()
  local browser_dlg = LuaDialog(c)
  local b_ids = {}
  
  local browser_layout = {
    LinearLayout;
    orientation = "vertical";
    {
      TextView;
      id = "current_path_tv";
      text = startPath;
      padding = "10dp";
      textSize = "12sp";
      textColor = "#0055A4";
      backgroundColor = "#E0E0E0";
      layout_width = "fill";
    };
    {
      ScrollView;
      layout_width = "fill";
      layout_weight = "1";
      {
        LinearLayout;
        orientation = "vertical";
        id = "files_container";
        layout_width = "fill";
        padding = "10dp";
      };
    };
  }
  
  browser_dlg.setView(loadlayout(browser_layout, b_ids))
  browser_dlg.setTitle("Select Backup (.txt) File")
  
  local function loadPath(path)
    b_ids.files_container.removeAllViews()
    b_ids.current_path_tv.setText("Path: " .. path)
    
    local dir = File(path)
    
    if path ~= "/storage/emulated/0" and path ~= "/" then
      local backBtn = loadlayout({
        Button;
        text = "GO BACK";
        layout_width = "fill";
        textColor = "#AA0000";
      })
      pcall(function() backBtn.setAllCaps(false) end)
      backBtn.onClick = function() loadPath(dir.getParent()) end
      b_ids.files_container.addView(backBtn)
    end
    
    if dir.exists() and dir.isDirectory() then
      local files = dir.listFiles()
      if files then
        local sortedFiles = {}
        for i=0, #files-1 do table.insert(sortedFiles, files[i]) end
        table.sort(sortedFiles, function(a,b)
          if a.isDirectory() and not b.isDirectory() then return true end
          if not a.isDirectory() and b.isDirectory() then return false end
          return a.getName():lower() < b.getName():lower()
        end)
        
        for _, f in ipairs(sortedFiles) do
          local fname = tostring(f.getName())
          if f.isDirectory() and not fname:match("^%.") then
            local btn = loadlayout({
              Button;
              text = fname;
              layout_width = "fill";
              textColor = "#0055A4";
            })
            pcall(function() btn.setAllCaps(false) end)
            btn.onClick = function() loadPath(f.getAbsolutePath()) end
            b_ids.files_container.addView(btn)
            
          elseif f.isFile() and fname:match("%.txt$") then 
            local btn = loadlayout({
              Button;
              text = fname;
              layout_width = "fill";
              textColor = "#006600";
            })
            pcall(function() btn.setAllCaps(false) end)
            btn.onClick = function()
              browser_dlg.dismiss()
              importFile(f.getAbsolutePath())
            end
            b_ids.files_container.addView(btn)
          end
        end
      end
    else
      b_ids.files_container.addView(loadlayout({
        TextView;
        text = "This folder is empty or access is denied.",
        gravity = "center";
      }))
    end
  end
  
  loadPath(startPath)
  browser_dlg.setButton("Cancel", function() browser_dlg.dismiss() end)
  browser_dlg.show()
end

