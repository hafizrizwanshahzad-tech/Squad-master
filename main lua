function searchPlayerInTournamentDialog(tourIndex)
  local c = getContext()
  triggerFeedback()
  local tour = recordsList[tourIndex]
  if not tour then return end
  
  if not tour.teams or #tour.teams == 0 then
    showToast("No teams found in this tournament!")
    return
  end
  
  local sDlg = LuaDialog(c)
  registerDialog(sDlg)
  sDlg.setTitle("Find Player in " .. tour.tournament)
  
  local scroll = ScrollView(c)
  local l = LinearLayout(c)
  l.setOrientation(1)
  l.setPadding(30, 30, 30, 30)
  scroll.addView(l)
  
  local infoTv = TextView(c)
  infoTv.setText("Search player across teams. Click any player button below to edit name:")
  infoTv.setPadding(0, 0, 0, 10)
  l.addView(infoTv)
  
  local eSearch = EditText(c)
  eSearch.setHint("Enter player name to find...")
  l.addView(eSearch)
  
  local bFind = Button(c)
  bFind.setText("Search Player")
  l.addView(bFind)
  
  local resultsContainer = LinearLayout(c)
  resultsContainer.setOrientation(1)
  resultsContainer.setPadding(0, 15, 0, 0)
  l.addView(resultsContainer)
  
  local function executePlayerSearch()
    triggerFeedback()
    resultsContainer.removeAllViews()
    local query = eSearch.getText().toString():lower():match("^%s*(.-)%s*$")
    if not query or query == "" then
      showToast("Please enter a player name!")
      return
    end
    
    local foundPlayers = {}
    for tmIdx, tm in ipairs(tour.teams) do
      if tm.players then
        for pIdx, pName in ipairs(tm.players) do
          if pName:lower():find(query, 1, true) then
            table.insert(foundPlayers, {
              teamIndex = tmIdx,
              playerIndex = pIdx,
              teamName = tm.teamName,
              playerName = pName
            })
          end
        end
      end
    end
    
    if #foundPlayers == 0 then
      local noResTv = TextView(c)
      noResTv.setText("No player found matching '" .. query .. "' in " .. tour.tournament)
      noResTv.setPadding(0, 10, 0, 10)
      resultsContainer.addView(noResTv)
      return
    end
    
    local countTv = TextView(c)
    countTv.setText("Found " .. #foundPlayers .. " player(s) (Click button to Edit):")
    countTv.setTypeface(nil, 1)
    countTv.setTextColor(0xFF00796B)
    countTv.setPadding(0, 5, 0, 10)
    resultsContainer.addView(countTv)
    
    for _, matchItem in ipairs(foundPlayers) do
      local pBtn = Button(c)
      pBtn.setText(matchItem.playerName .. "  [" .. matchItem.teamName .. "]")
      pBtn.setLayoutParams(LinearLayout.LayoutParams(-1, -2))
      pBtn.setPadding(10, 15, 10, 15)
      
      pBtn.onClick = function()
        triggerFeedback()
        local renDlg = LuaDialog(c)
        registerDialog(renDlg)
        renDlg.setTitle("Edit Player: " .. matchItem.playerName)
        
        local renLay = LinearLayout(c)
        renLay.setOrientation(1)
        renLay.setPadding(30, 30, 30, 30)
        
        local infoT = TextView(c)
        infoT.setText("Team: " .. matchItem.teamName .. "\nEnter new player name below:")
        infoT.setPadding(0, 0, 0, 15)
        renLay.addView(infoT)
        
        local eNewName = EditText(c)
        eNewName.setText(matchItem.playerName)
        renLay.addView(eNewName)
        
        local bSaveRen = Button(c)
        bSaveRen.setText("Save & Update")
        bSaveRen.setPadding(0, 15, 0, 0)
        bSaveRen.onClick = function()
          triggerFeedback()
          local updatedName = eNewName.getText().toString():match("^%s*(.-)%s*$")
          if updatedName == "" then
            showToast("Player name cannot be empty!")
            return
          end
          
          local targetTeam = tour.teams[matchItem.teamIndex]
          if not targetTeam or not targetTeam.players then return end
          
          -- Check duplicates in the same team
          local isDuplicate = false
          for cIdx, existingPlayer in ipairs(targetTeam.players) do
            if cIdx ~= matchItem.playerIndex and existingPlayer:lower() == updatedName:lower() then
              isDuplicate = true
              break
            end
          end
          
          if isDuplicate then
            showToast("Another player already has this name in " .. matchItem.teamName .. "!")
            return
          end

          -- Check duplicates across other teams
          for oIdx, otherTm in ipairs(tour.teams) do
            if oIdx ~= matchItem.teamIndex and otherTm.players then
              for _, oP in ipairs(otherTm.players) do
                if oP:lower() == updatedName:lower() then
                  local lockDlg = LuaDialog(c)
                  lockDlg.setTitle("Player Restriction Alert")
                  lockDlg.setMessage("Rule Violation: '" .. updatedName .. "' is already registered with team '" .. otherTm.teamName .. "' in this tournament.\n\nA player cannot play in two teams concurrently!")
                  lockDlg.setButton("OK", function() lockDlg.dismiss() end)
                  lockDlg.show()
                  return
                end
              end
            end
          end
          
          -- Replace and update in place
          targetTeam.players[matchItem.playerIndex] = updatedName
          saveData()
          showToast("Player updated successfully!")
          renDlg.dismiss()
          executePlayerSearch()
        end
        renLay.addView(bSaveRen)
        
        renDlg.setView(renLay)
        renDlg.show()
      end
      
      resultsContainer.addView(pBtn)
    end
  end
  
  bFind.onClick = function()
    executePlayerSearch()
  end
  
  sDlg.setView(scroll)
  sDlg.show()
end

