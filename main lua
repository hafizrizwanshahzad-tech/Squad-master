function getTournamentSummary(tour)
  local teamCount = tour.teams and #tour.teams or 0
  local playerCount = 0
  local readyTeamsCount = 0
  if tour.teams then
    for _, tm in ipairs(tour.teams) do
      local pNum = #(tm.players or {})
      playerCount = playerCount + pNum
      if pNum >= 11 then
        readyTeamsCount = readyTeamsCount + 1
      end
    end
  end
  local status = (tour.status == "Completed") and "Completed" or "Active"
  return teamCount, playerCount, status, readyTeamsCount
end

