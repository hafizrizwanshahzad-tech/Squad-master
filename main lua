  local function getFormattedSquadText()
    local captainItem = nil
    local viceCaptainItem = nil
    local selectedPlayersList = {}
    local reservePlayers = {}
    local totalSelectedCount = 0
    local totalAvailablePlayers = #tm.players
    
    for _, item in ipairs(playerItemsList) do
      if item.cb.isChecked() then
        totalSelectedCount = totalSelectedCount + 1
        if item.role == "C" then
          captainItem = item
        elseif item.role == "VC" then
          viceCaptainItem = item
        elseif item.role == "R" then
          table.insert(reservePlayers, item.name)
        else
          table.insert(selectedPlayersList, item.name)
        end
      end
    end
    
    if totalSelectedCount == 0 then
      return nil
    end
    
    local resultLines = {}
    local tourEmoji = getCustomEmoji("tournament", "🏆")
    local battleEmoji = getCustomEmoji("battle", "⚔️")
    local timeEmoji = getCustomEmoji("time", "⏰")
    local capEmoji = getCustomEmoji("captain", "👑")
    local vcEmoji = getCustomEmoji("vc", "⭐")
    local resEmojiVal = getCustomEmoji("reserve", "🔄")
    
    local listEmoji = ""
    local resEmoji = ""
    if isEmojiGlobalEnabled() then
      listEmoji = isCustomEmojiEnabled() and "📋 " or (getRandomEmoji("list") .. " ")
      resEmoji = (resEmojiVal ~= "" and (resEmojiVal .. " ") or "")
    end
    
    local isFullSquad = (totalSelectedCount == totalAvailablePlayers) and (#reservePlayers == 0)
    local normalCount = #selectedPlayersList + (captainItem and 1 or 0) + (viceCaptainItem and 1 or 0)
    
    local tLine = "Tournament: " .. tour.tournament
    if tourEmoji ~= "" then tLine = tourEmoji .. " " .. tLine end
    table.insert(resultLines, tLine)
    
    local matchTitleLine = ""
    if activeOpponent and activeOpponent ~= "" then
      if isFullSquad then
        matchTitleLine = tm.teamName .. " vs " .. activeOpponent
      else
        matchTitleLine = tm.teamName .. (normalCount > 0 and (" (Playing " .. normalCount .. ")") or "") .. " vs " .. activeOpponent
      end
    else
      if isFullSquad then
        matchTitleLine = tm.teamName .. " Squad"
      else
        matchTitleLine = tm.teamName .. " Playing " .. normalCount
      end
    end
    
    if battleEmoji ~= "" then matchTitleLine = battleEmoji .. " " .. matchTitleLine end
    table.insert(resultLines, matchTitleLine)

    if activeMatchTime and activeMatchTime ~= "" then
      local timeLine = activeMatchTime
      if timeEmoji ~= "" then timeLine = timeEmoji .. " " .. timeLine end
      table.insert(resultLines, timeLine)
    end

    if activeGround and activeGround ~= "" then
      table.insert(resultLines, "Ground: " .. activeGround)
    end
    
    table.insert(resultLines, "")
    
    local listHeading = ""
    if isFullSquad then
      listHeading = "Squad (" .. normalCount .. "):"
    else
      listHeading = "Playing " .. normalCount .. ":"
    end

    table.insert(resultLines, listEmoji .. listHeading)
    
    local printIdx = 1
    if captainItem then
      local cLine = printIdx .. ". Captain: " .. captainItem.name
      if capEmoji ~= "" then
        cLine = printIdx .. ". " .. capEmoji .. " Captain: " .. captainItem.name
      end
      table.insert(resultLines, cLine)
      printIdx = printIdx + 1
    end
    
    if viceCaptainItem then
      local vcLine = printIdx .. ". Vice-Captain: " .. viceCaptainItem.name
      if vcEmoji ~= "" then
        vcLine = printIdx .. ". " .. vcEmoji .. " Vice-Captain: " .. viceCaptainItem.name
      end
      table.insert(resultLines, vcLine)
      printIdx = printIdx + 1
    end
    
    for _, pName in ipairs(selectedPlayersList) do
      local pEm = ""
      if isEmojiGlobalEnabled() then
        pEm = getRandomEmoji("player")
        if pEm ~= "" then pEm = pEm .. " " end
      end
      table.insert(resultLines, printIdx .. ". " .. pEm .. pName)
      printIdx = printIdx + 1
    end
    
    if #reservePlayers > 0 then
      table.insert(resultLines, "")
      local reserveHeading = "Reserve (" .. #reservePlayers .. "):"
      table.insert(resultLines, resEmoji .. reserveHeading)
      
      local resIdx = 1
      for _, pName in ipairs(reservePlayers) do
        local rEm = ""
        if isEmojiGlobalEnabled() then
          rEm = getRandomEmoji("player")
          if rEm ~= "" then rEm = rEm .. " " end
        end
        table.insert(resultLines, resIdx .. ". " .. rEm .. pName)
        resIdx = resIdx + 1
      end
    end

    if activeSpecialNotice and activeSpecialNotice ~= "" then
      table.insert(resultLines, "")
      table.insert(resultLines, "Note: " .. activeSpecialNotice)
    end
    
    return table.concat(resultLines, "\n")
  end

  local function refreshDetailPreview()
    local text = getFormattedSquadText()
    if text then
      detailPreviewBox.setText(text)
