          count = count + 1
        end
      end
      countStatusTv.setText("Selected Players: " .. count)
      refreshDetailPreview()
    end

    for _, item in ipairs(playerItemsList) do
      item.cb.setOnCheckedChangeListener(function()
        updateSelectedCount()
      end)
      
