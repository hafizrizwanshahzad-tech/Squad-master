        showToast("Select at least one player!")
        return
      end
      shareTextMenu(fullCopyText)
    end
    buttonRowLayout.addView(shareBtn)

    local directWpBtn = Button(c)
    directWpBtn.setText("Advice Captain Personal Chat")
    directWpBtn.setLayoutParams(LinearLayout.LayoutParams(0, -2, 1))
    directWpBtn.onClick = function()
      local fullCopyText = getFormattedSquadText()
      if not fullCopyText then
        showToast("Select at least one player!")
        return
      end
      showDirectWhatsAppSendDialog(fullCopyText)
    end
