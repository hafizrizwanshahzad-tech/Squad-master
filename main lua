        ttsObj = TextToSpeech(c, TextToSpeech.OnInitListener {
          onInit = function(status)
            if status == TextToSpeech.SUCCESS then
              pcall(function() ttsObj.setLanguage(Locale.ENGLISH) end)
              local cleanSpeechText = squadText:gsub("[%z\1-\127\194-\244][\128-\191]*", function(char)
                if #char > 1 then return "" end
                return char
              end)
              ttsObj.speak(cleanSpeechText, TextToSpeech.QUEUE_FLUSH, nil, nil)
              showToast("Announcing Squad...")
            else
              showToast("TTS Initialization Failed!")
            end
          end
        })
      end)
