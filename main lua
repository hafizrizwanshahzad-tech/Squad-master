function showEditAllPlayersDialog(tourIndex, teamIndex, parentDetailDlg)
  local c = getContext()
  triggerFeedback()
  
  local tour = recordsList[tourIndex]
  if not tour or not tour.teams or not tour.teams[teamIndex] then return end
  local tm = tour.teams[teamIndex]
  
  if not tm.players or #tm.players == 0 then
    showToast("No players found to edit!")
    return
  end
  
  local edDlg = LuaDialog(c)
  registerDialog(edDlg)
  edDlg.setTitle("Edit All Players (" .. tm.teamName .. ")")
  
  local scroll = ScrollView(c)
  local l = LinearLayout(c)
  l.setOrientation(1)
  l.setPadding(30, 30, 30, 30)
  scroll.addView(l)
  
  local tvInfo = TextView(c)
  tvInfo.setText("Click 'Rename' to change any player's name:")
  tvInfo.setPadding(0, 0, 0, 15)
  l.addView(tvInfo)
  
  local playerListContainer = LinearLayout(c)
  playerListContainer.setOrientation(1)
  l.addView(playerListContainer)
  
  local function refreshList()
    playerListContainer.removeAllViews()
    for idx, pName in ipairs(tm.players) do
      local row = LinearLayout(c)
      row.setOrientation(0)
      row.setGravity(Gravity.CENTER_VERTICAL)
      row.setPadding(0, 8, 0, 8)
      
      local tvName = TextView(c)
      tvName.setText(idx .. ". " .. pName)
      tvName.setTextSize(15)
      tvName.setLayoutParams(LinearLayout.LayoutParams(0, -2, 1))
      row.addView(tvName)
      
      local renBtn = Button(c)
      renBtn.setText("Rename")
      renBtn.setLayoutParams(LinearLayout.LayoutParams(-2, -2))
      renBtn.onClick = function()
        triggerFeedback()
        local renSingleDlg = LuaDialog(c)
        registerDialog(renSingleDlg)
        renSingleDlg.setTitle("Rename Player")
        
        local sLay = LinearLayout(c)
        sLay.setOrientation(1)
        sLay.setPadding(30, 30, 30, 30)
        
        local eNew = EditText(c)
        eNew.setText(pName)
        sLay.addView(eNew)
        
        local bApply = Button(c)
        bApply.setText("Save Name")
        bApply.setPadding(0, 15, 0, 0)
        bApply.onClick = function()
          triggerFeedback()
          local updatedName = eNew.getText().toString():match("^%s*(.-)%s*$")
          if updatedName == "" then
            showToast("Player name cannot be empty!")
            return
          end
          
          local isDuplicate = false
          for checkIdx, existingPlayer in ipairs(tm.players) do
            if checkIdx ~= idx and existingPlayer:lower() == updatedName:lower() then
              isDuplicate = true
              break
            end
          end
          
          if isDuplicate then
            showToast("Another player already has this name in this team!")
            return
          end

          for oIdx, otherTm in ipairs(tour.teams) do
            if oIdx ~= teamIndex and otherTm.players then
              for _, oP in ipairs(otherTm.players) do
                if oP:lower() == updatedName:lower() then
                  local lockDlg = LuaDialog(c)
                  lockDlg.setTitle("Player Restriction Alert")
                  lockDlg.setMessage("Rule Violation: '" .. updatedName .. "' is already registered with team '" .. otherTm.teamName .. "' in this tournament.\n\nA player cannot play in two teams concurrently!")
                  lockDlg.setButton("OK", function() lockDlg.dismiss() end)
                  lockDlg.show()
                  return
                end
              end
            end
          end
          
          tm.players[idx] = updatedName
          saveData()
          showToast("Player renamed successfully!")
          renSingleDlg.dismiss()
          refreshList()
        end
        sLay.addView(bApply)
        
        renSingleDlg.setView(sLay)
        renSingleDlg.show()
      end
      row.addView(renBtn)
      playerListContainer.addView(row)
    end
  end
  
  refreshList()
  
  local bClose = Button(c)
  bClose.setText("Done & Refresh")
  bClose.setPadding(0, 20, 0, 0)
  bClose.onClick = function()
    triggerFeedback()
    edDlg.dismiss()
    if parentDetailDlg then parentDetailDlg.dismiss() end
    showTournamentDetailView(tourIndex, teamIndex)
  end
  l.addView(bClose)
  
  edDlg.setView(scroll)
  edDlg.show()
end

