    local pListLay = LinearLayout(c)
    pListLay.setOrientation(1)
    pListLay.setPadding(20, 20, 20, 20)
    pScroll.addView(pListLay)
    
    local previewTv = TextView(c)
    previewTv.setText("Selected: " .. singleInput.getText().toString())
    previewTv.setTextSize(16)
    previewTv.setPadding(0, 0, 0, 15)
    pListLay.addView(previewTv)

    local currentDraft = singleInput.getText().toString()
    
    for _, em in ipairs(presetEmojis) do
      local emoBtn = Button(c)
      emoBtn.setText("Select " .. em)
      emoBtn.onClick = function()
        triggerFeedback()
        currentDraft = em
        previewTv.setText("Selected: " .. currentDraft)
      end
      pListLay.addView(emoBtn)
    end

    local clearDraftBtn = Button(c)
    clearDraftBtn.setText("Clear")
    clearDraftBtn.onClick = function()
      triggerFeedback()
      currentDraft = ""
      previewTv.setText("Selected: (empty)")
    end
    pListLay.addView(clearDraftBtn)

    local doneBtn = Button(c)
    doneBtn.setText("Done")
    doneBtn.setPadding(0, 15, 0, 0)
    doneBtn.onClick = function()
      triggerFeedback()
      singleInput.setText(currentDraft)
      saveCustomEmoji(steps[currentStep].key, currentDraft)
      pDlg.dismiss()
    end
    pListLay.addView(doneBtn)
    
    pDlg.setView(pScroll)
    pDlg.show()
  end

  local navRow = LinearLayout(c)
  navRow.setOrientation(0)
  navRow.setPadding(0, 15, 0, 0)

  local prevBtn = Button(c)
  prevBtn.setText("Previous")
  prevBtn.setLayoutParams(LinearLayout.LayoutParams(0, -2, 1))

  local nextBtn = Button(c)
  nextBtn.setText("Next")
  nextBtn.setLayoutParams(LinearLayout.LayoutParams(0, -2, 1))

  navRow.addView(prevBtn)
  navRow.addView(nextBtn)
  l.addView(navRow)

  local bReset = Button(c)
  bReset.setText("Reset All to Default")
  bReset.setPadding(0, 10, 0, 0)
  l.addView(bReset)

  local bCloseDirect = Button(c)
  bCloseDirect.setText("Cancel & Close")
  l.addView(bCloseDirect)

  local function renderStep()
    local item = steps[currentStep]
    stepTitleTv.setText(item.label)
    local val = p.getString("emoji_" .. item.key, item.defaultVal)
    singleInput.setText(val)

    prevBtn.setEnabled(currentStep > 1)
    if currentStep == #steps then
      nextBtn.setText("Save All & Close")
    else
      nextBtn.setText("Next")
    end
  end

  prevBtn.onClick = function()
    triggerFeedback()
    saveCustomEmoji(steps[currentStep].key, singleInput.getText().toString())
    if currentStep > 1 then
      currentStep = currentStep - 1
      renderStep()
    end
  end

  nextBtn.onClick = function()
    triggerFeedback()
    saveCustomEmoji(steps[currentStep].key, singleInput.getText().toString())
    if currentStep < #steps then
      currentStep = currentStep + 1
      renderStep()
    else
      showToast("All Custom Emojis Saved Successfully!")
      emDlg.dismiss()
      if parentDlg then parentDlg.show() end
    end
  end

  bReset.onClick = function()
    triggerFeedback()
    for _, st in ipairs(steps) do
      saveCustomEmoji(st.key, st.defaultVal)
    end
    renderStep()
    showToast("All emojis reset to default!")
  end

  bCloseDirect.onClick = function()
    triggerFeedback()
    saveCustomEmoji(steps[currentStep].key, singleInput.getText().toString())
    emDlg.dismiss()
    if parentDlg then parentDlg.show() end
  end

  renderStep()
  emDlg.setView(scroll)

  pcall(function()
    local win = emDlg.getWindow()
    if win then
      win.setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_STATE_ALWAYS_HIDDEN)
    end
  end)

  emDlg.show()

  Handler(Looper.getMainLooper()).post(Runnable({
    run = function()
      pcall(function()
        globalEnableCb.requestFocus()
        scroll.scrollTo(0, 0)
      end)
    end
  }))
end

function showSettings()
  local c = getContext()
  triggerFeedback()
  local sDlg = LuaDialog(c)
  registerDialog(sDlg)
  sDlg.setTitle("Settings")

  local scroll = ScrollView(c)
  local l = LinearLayout(c)
  l.setOrientation(1)
  l.setPadding(30, 30, 30, 30)
  scroll.addView(l)

  local p = c.getSharedPreferences("TournamentManager_Prefs", 0)

  local vCb = CheckBox(c)
  vCb.setText("Vibration Feedback")
  vCb.setChecked(p.getBoolean("vibration", true))
  vCb.setOnCheckedChangeListener(function(btnView, isChecked)
    triggerFeedback()
    local editor = p.edit()
    editor.putBoolean("vibration", isChecked)
    editor.commit()
    showToast(isChecked and "Vibration Enabled" or "Vibration Disabled")
  end)
  l.addView(vCb)

  local bEmoji = Button(c)
  bEmoji.setText("Custom Emojis Settings")
  bEmoji.setPadding(0, 15, 0, 0)
  bEmoji.onClick = function()
    sDlg.dismiss()
    showCustomEmojiSettings(sDlg)
  end
  l.addView(bEmoji)

  local bClose = Button(c)
  bClose.setText("Close")
  bClose.setPadding(0, 20, 0, 0)
  bClose.onClick = function()
    triggerFeedback()
    sDlg.dismiss()
  end
  l.addView(bClose)

  sDlg.setView(scroll)
  sDlg.show()
end

