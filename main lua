function getRandomEmoji(category)
  math.randomseed(os.time() + math.random(100, 999))
  local list = RANDOM_EMOJIS[category]
  if list and #list > 0 then
    local idx = math.random(1, #list)
    return list[idx]
  end
  return ""
end

function getCustomEmoji(key, defaultVal)
  local c = getContext()
  local p = c.getSharedPreferences("TournamentManager_Prefs", 0)
  if not isEmojiGlobalEnabled() then
    return ""
  end
  if isCustomEmojiEnabled() then
    return p.getString("emoji_" .. key, defaultVal)
  end
  return getRandomEmoji(key)
end

function saveCustomEmoji(key, val)
  local c = getContext()
  local p = c.getSharedPreferences("TournamentManager_Prefs", 0)
  local editor = p.edit()
  editor.putString("emoji_" .. key, val)
  editor.commit()
end

