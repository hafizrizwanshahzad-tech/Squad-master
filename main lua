local function performExport(itemsToExport)
  local c = getContext()
  if #itemsToExport == 0 then
    showToast("No tournaments to export!")
    return
  end
  
  local firstTourName = itemsToExport[1].tournament or "Tournament"
  firstTourName = firstTourName:gsub("[\\/:*?\"<>|]", "_"):gsub("%s+", "_")
  if firstTourName == "" then firstTourName = "TournamentManager" end
  
  local exportPath = "/storage/emulated/0/Documents/" .. firstTourName .. "_Backup.txt"
  
  pcall(function()
    local f = io.open(exportPath, "w")
    if f then
      for _, tour in ipairs(itemsToExport) do
        local tStatus = (tour.status == "Completed") and "Completed" or "Active"
        if tour.teams and #tour.teams > 0 then
          for _, tm in ipairs(tour.teams) do
            local pStr = table.concat(tm.players or {}, "\n")
            local block = "Tournament: " .. tour.tournament .. "\nStatus: " .. tStatus .. "\nTeam: " .. tm.teamName .. "\nPlayers:\n" .. pStr .. "\n[---END---]\n\n"
            f:write(block)
          end
        else
          local block = "Tournament: " .. tour.tournament .. "\nStatus: " .. tStatus .. "\nTeam: None\nPlayers:\n\n[---END---]\n\n"
          f:write(block)
        end
      end
      f:close()
      
      local success_dlg = LuaDialog(c)
      success_dlg.setTitle("Export Successful")
      success_dlg.setMessage(#itemsToExport .. " tournament(s) successfully backed up!\n\nFile Name: " .. firstTourName .. "_Backup.txt\nPath: " .. exportPath)
      success_dlg.setButton("OK", function() success_dlg.dismiss() end)
      success_dlg.show()
      
      showToast("Backup saved as " .. firstTourName .. "_Backup.txt")
      speakTTS("Backup Exported Successfully")
    else
      showToast("Export Failed! Check storage permissions.")
    end
  end)
end

