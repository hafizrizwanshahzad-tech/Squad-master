function loadData()
  recordsList = {}
  pcall(function()
    local f = io.open(dataFile, "r")
    if f then
      local content = f:read("*all")
      f:close()
      if content and content ~= "" then
        for block in content:gmatch("(.-)%[---END---%]\n*") do
          if block ~= "" then
            local tour = block:match("Tournament: *(.-)\n")
            local cleanTour = tour and tour:match("^%s*(.-)%s*$") or "Unknown Tournament"
            
            local statusMatch = block:match("Status: *(.-)\n")
            local cleanStatus = statusMatch and statusMatch:match("^%s*(.-)%s*$") or "Active"
            if cleanStatus ~= "Completed" then cleanStatus = "Active" end
            
            local tourObj = nil
            for _, t in ipairs(recordsList) do
              if t.tournament:lower() == cleanTour:lower() then
                tourObj = t
                break
              end
            end
            if not tourObj then
              tourObj = { tournament = cleanTour, status = cleanStatus, teams = {} }
              table.insert(recordsList, tourObj)
            else
              tourObj.status = cleanStatus
            end

            local teamName = block:match("Team: *(.-)\n") or block:match("Team: *(.*)")
            teamName = teamName and teamName:match("^%s*(.-)%s*$") or ""
            
            local playersStr = block:match("Players:\n*(.*)") or block:match("Players: *(.*)")
            local players = {}
            if playersStr and playersStr ~= "" then
              for p in playersStr:gmatch("[^\r\n]+") do
                local trimmed = p:match("^%s*(.-)%s*$")
                if trimmed ~= "" and trimmed ~= "Players:" then
                  table.insert(players, trimmed)
                end
              end
            end
            
            if teamName ~= "" and teamName:lower() ~= "none" then
              table.insert(tourObj.teams, {
                teamName = teamName,
                players = players
              })
            end
          end
        end
      end
    end
  end)
end

function saveData()
  pcall(function()
    local f = io.open(dataFile, "w")
    if f then
      for _, tour in ipairs(recordsList) do
        local tStatus = (tour.status == "Completed") and "Completed" or "Active"
        if tour.teams and #tour.teams > 0 then
          for _, tm in ipairs(tour.teams) do
            local pStr = table.concat(tm.players or {}, "\n")
            local block = "Tournament: " .. tour.tournament .. "\nStatus: " .. tStatus .. "\nTeam: " .. tm.teamName .. "\nPlayers:\n" .. pStr .. "\n[---END---]\n\n"
            f:write(block)
          end
        else
          local block = "Tournament: " .. tour.tournament .. "\nStatus: " .. tStatus .. "\nTeam: None\nPlayers:\n\n[---END---]\n\n"
          f:write(block)
        end
      end
      f:close()
    end
  end)
end

function clearAllData()
  recordsList = {}
  saveData()
end

