    local bSaveP = Button(c)
    bSaveP.setText("Save")
    bSaveP.setPadding(0, 15, 0, 0)
    bSaveP.onClick = function()
      triggerFeedback()
      local rawText = eP.getText().toString()
      if rawText ~= "" then
        tm.players = tm.players or {}
        local existingMap = {}
        for _, existingName in ipairs(tm.players) do
          existingMap[existingName:lower()] = true
        end

        local addedCount = 0
        local duplicateCount = 0
        local blockedPlayersList = {}

        for p in rawText:gmatch("[^\r\n]+") do
          local trimmed = p:match("^%s*(.-)%s*$")
          if trimmed ~= "" then
            local checkKey = trimmed:lower()
            if not existingMap[checkKey] then
              local blockedByTeam = nil
              for oIdx, otherTm in ipairs(tour.teams) do
                if oIdx ~= teamIndex and otherTm.players then
                  for _, oP in ipairs(otherTm.players) do
                    if oP:lower() == checkKey then
                      blockedByTeam = otherTm.teamName
                      break
                    end
                  end
                end
                if blockedByTeam then break end
              end

              if blockedByTeam then
                table.insert(blockedPlayersList, "• " .. trimmed .. " is registered with " .. blockedByTeam)
              else
                table.insert(tm.players, trimmed)
                existingMap[checkKey] = true
                addedCount = addedCount + 1
              end
            else
              duplicateCount = duplicateCount + 1
            end
          end
        end

        if addedCount > 0 then
          saveData()
          pDlg.dismiss()
          detailDlg.dismiss()
          showTournamentDetailView(tourIndex, teamIndex)

          if #blockedPlayersList > 0 then
            local blockedDlg = LuaDialog(c)
            blockedDlg.setTitle("Player Eligibility Restriction")
            blockedDlg.setMessage("The following player(s) were BLOCKED from joining because they are already playing for another team in this tournament:\n\n" .. table.concat(blockedPlayersList, "\n\n") .. "\n\nRule: A player cannot play in two teams. Please transfer them legitimately.")
            blockedDlg.setButton("I Understand", function() blockedDlg.dismiss() end)
            blockedDlg.show()
          else
            if duplicateCount > 0 then
              showToast(addedCount .. " player(s) added. " .. duplicateCount .. " duplicate(s) skipped!")
            else
              showToast("Player(s) added successfully!")
            end
          end
        else
          if #blockedPlayersList > 0 then
            local blockedDlg = LuaDialog(c)
            blockedDlg.setTitle("Action Blocked: Player Restriction")
            blockedDlg.setMessage("Registration Rejected!\n\n" .. table.concat(blockedPlayersList, "\n\n") .. "\n\nRule: A player cannot play in two teams within the same tournament!")
            blockedDlg.setButton("OK", function() blockedDlg.dismiss() end)
            blockedDlg.show()
          else
            showToast("Player already exists in this team!")
          end
        end
      else
        showToast("Please enter or import player names!")
      end
    end
