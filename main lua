function getRecentWhatsAppNumbers()
  local c = getContext()
  local p = c.getSharedPreferences("TournamentManager_Prefs", 0)
  local raw = p.getString("recent_wa_numbers", "")
  local list = {}
  if raw and raw ~= "" then
    for item in raw:gmatch("[^,]+") do
      local trimmed = item:match("^%s*(.-)%s*$")
      if trimmed ~= "" then table.insert(list, trimmed) end
    end
  end
  return list
end

function saveRecentWhatsAppNumber(num)
  if not num or num == "" then return end
  local c = getContext()
  local p = c.getSharedPreferences("TournamentManager_Prefs", 0)
  local list = getRecentWhatsAppNumbers()
  
  local cleanList = {}
  table.insert(cleanList, tostring(num))
  for _, item in ipairs(list) do
    if item ~= tostring(num) and #cleanList < 5 then
      table.insert(cleanList, item)
    end
  end
  
  local editor = p.edit()
  editor.putString("recent_wa_numbers", table.concat(cleanList, ","))
  editor.commit()
end

